# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/studysteady?retryWrites=true&w=majority

# Long random secret used to sign JWTs
JWT_SECRET=replace-with-a-long-random-secret

# Optional: comma-separated frontend origins. Leave empty for local development.

# Render provides PORT automatically; local development defaults to 5000.
PORT=5000
CORS_ORIGINS=https://study-steady-n.netlify.app

# Email reminders (Resend)
RESEND_API_KEY=
EMAIL_FROM=StudySteady <reminders@your-verified-domain.com>
